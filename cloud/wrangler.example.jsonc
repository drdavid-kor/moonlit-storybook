{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "moonlit-storybook",
  "main": "worker.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "STORYBOOK_MODEL": "google/gemini-3.8-flash",
    "ASR_MODEL": "qwen/qwen3-asr-0.6b",
    "IMAGE_MODEL": "bytedance-seed/seedream-5-0-flash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moonlit-storybook-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "name": "moonlit-story-generation",
      "binding": "STORIES",
      "class_name": "StoryGeneration"
    },
    {
      "name": "moonlit-illustration-upgrade",
      "binding": "ILLUSTRATOR",
      "class_name": "StoryIllustration"
    }
  ],
  "triggers": {
    "crons": [
      "17 19 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "r2_buckets": [
    {
      "binding": "ART",
      "bucket_name": "moonlit-storybook-art"
    }
  ]
}
